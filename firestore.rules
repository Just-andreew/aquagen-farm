rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return request.auth != null && (role == 'admin' || role == 'super-admin');
    }

    // Helper function for retail staff (sellers, supervisors, and admins)
    function isRetailStaff() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return request.auth != null && (role == 'retail_seller' || role == 'supervisor' || role == 'admin' || role == 'super-admin');
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    match /routines/{routineId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, update, create: if isAdmin() || isRetailStaff();
      allow delete: if false; 
    }

    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /inventory_history/{historyId} {
      allow read, write: if request.auth != null;
    }

    match /sales/{saleId} {
      allow read, create: if isAdmin() || isRetailStaff();
      
      // Allow delete only if the invoice is a Draft
      allow delete: if isAdmin() && resource.data.status == 'Draft';
      
      allow update: if isAdmin() && (
        // Allow full updates if it's currently a Draft
        resource.data.status == 'Draft' 
        || 
        // If it's finalized, ONLY allow status updates to Void or Reversed, or non-destructive retail metadata backfill
        (
          (resource.data.status == 'Pending' || resource.data.status == 'Paid')
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['Void', 'Reversed']
            )
            ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branch_id', 'shift_date_key', 'line_items', 'cogs_total', 'gross_margin'])
          )
        )
      );
    }
    
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }
  
    match /ledger_entries/{entryId} {
      allow read, write: if isAdmin();
    }
    
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /feeder_telemetry/{docId} {
      allow read: if request.auth != null;
    }

    match /ponds/{pondId} {
      allow read, write: if request.auth != null;
    }

    // --- RETAIL MODULE COLLECTIONS ---
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() || isRetailStaff();
      allow delete: if isAdmin();
    }

    match /retail_raw_packets/{packetId} {
      allow read, create, update: if isRetailStaff();
      allow delete: if isAdmin();
    }

    match /retail_fried_stock/{stockId} {
      allow read, create, update: if isRetailStaff();
      allow delete: if isAdmin();
    }

    match /retail_conversions/{conversionId} {
      allow read: if isRetailStaff();
      allow create, update, delete: if isAdmin();
    }

    match /retail_deliveries/{deliveryId} {
      allow read, create, update: if isRetailStaff();
      allow delete: if isAdmin();
    }

    match /retail_shifts/{shiftId} {
      allow read, create, update: if isRetailStaff();
      allow delete: if isAdmin();
    }

    match /retail_inventory_history/{historyId} {
      allow read, create: if isRetailStaff();
      allow update, delete: if isAdmin();
    }
  }
}
