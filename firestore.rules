rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    match /routines/{routineId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, update: if isAdmin();
      allow create, delete: if false; 
    }

    match /sales/{saleId} {
      allow read, create: if isAdmin();
      
      // Allow delete only if the invoice is a Draft
      allow delete: if isAdmin() && resource.data.status == 'Draft';
      
      allow update: if isAdmin() && (
        // Allow full updates if it's currently a Draft
        resource.data.status == 'Draft' 
        || 
        // If it's finalized, ONLY allow status updates to Void or Reversed
        (
          (resource.data.status == 'Pending' || resource.data.status == 'Paid')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Void', 'Reversed']
        )
      );
    }
    
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
